# SQLite database path (relative to prisma/ when using file:./)
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth (generate: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-random-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional) — https://console.cloud.google.com/apis/credentials
# OAuth client type: Web application
# Authorized redirect URI (exact): http://localhost:3000/api/auth/callback/google
# If consent screen is "Testing", add your Gmail as a Test user
# Leave empty to use email login for local development
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenRouter — AI portfolio suggestions
# https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="inclusionai/ling-3.0-flash-fin:free"
OPENROUTER_FALLBACK_MODELS="minimax/minimax-m3:free"

# Optional overrides
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# OPENROUTER_HTTP_REFERER="http://localhost:3000"
