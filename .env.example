# Neon Postgres — https://neon.tech
# Pooled URL (Vercel / runtime):
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct URL (prisma db push):
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth (generate: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-random-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenRouter — AI portfolio suggestions
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="inclusionai/ling-3.0-flash-fin:free"
OPENROUTER_FALLBACK_MODELS="minimax/minimax-m3:free"
